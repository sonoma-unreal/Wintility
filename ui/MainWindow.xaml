                             Foreground="{DynamicResource SubBrush}"/>
                </StackPanel>
              </Border>
              <Border x:Name="PowerHighBox" BorderThickness="2" CornerRadius="14" Padding="18" Margin="8,0,0,12" MinHeight="200" Cursor="Hand"
                      Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}">
                <StackPanel>
                  <Control x:Name="PowerHighIcon" Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Rocket}" Width="30" Height="30"
                           HorizontalAlignment="Left" Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="PowerHighTitle" Text="High Performance" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="PowerHighDesc" Text="Keeps the CPU responsive for demanding apps and games. Uses more battery and runs warmer. Double-click to try Ultimate Performance." TextWrapping="Wrap" Margin="0,8,0,0"
                             Foreground="{DynamicResource SubBrush}"/>
                  <TextBlock x:Name="PowerHighStatus" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"
                             Foreground="{DynamicResource SubBrush}"/>
