                    CornerRadius="12" Margin="0,0,0,24" Padding="18,16">
              <StackPanel>
                <TextBlock Text="DNS resolver" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Choose a resolver for one connected network adapter. DNS-over-HTTPS encrypts DNS requests when supported by this Windows version." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,12" Foreground="{DynamicResource SubBrush}"/>
                <Grid>
