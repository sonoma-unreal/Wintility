            </Border>
            <TextBlock Text="SSD MAINTENANCE" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,24" Padding="18,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                  <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.HardDrive}" Width="20" Height="20" Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                  <TextBlock Text="Windows drive optimization" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Windows already schedules the right maintenance for each drive, including TRIM for SSDs. Open its built-in optimizer to run maintenance now or adjust the schedule." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                </StackPanel>
                <Button x:Name="OpenDriveOptimizerButton" Grid.Column="2" Content="Open Optimize Drives" Width="170" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel x:Name="Panel_Debloat"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="System Information" Tag="{DynamicResource Icon.Cpu}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,8,16">
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="13" Background="#1B4B78" VerticalAlignment="Center">
                <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Cpu}" Width="26" Height="26" Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="System Information" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="What this PC is made of and how it is connected." FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource SubBrush}"/>
              </StackPanel>
              <Button x:Name="RefreshInfoButton" Grid.Column="2" Content="Refresh" Width="100" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
            </Grid>
            <UniformGrid x:Name="SystemInfoPanel" Columns="2" VerticalAlignment="Top"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Credits" Tag="{DynamicResource Icon.Heart}">
          <Grid Margin="0,10,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BoxBrush}"
                      BorderThickness="1.5" CornerRadius="12" Padding="24" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Engineered by" FontSize="13" HorizontalAlignment="Center"
                             Foreground="{DynamicResource SubBrush}"/>
                  <TextBlock x:Name="ClaudeLink" Text="Claude" Tag="https://claude.ai" ToolTip="https://claude.ai"
                             FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"
                             Foreground="#3C8DDE" TextDecorations="Underline" Cursor="Hand"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BoxBrush}"
                      BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Image x:Name="CodexCreditIcon" Width="52" Height="52" Stretch="Uniform"
                         VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AI coding assistant" FontSize="13" Foreground="{DynamicResource SubBrush}"/>
                    <TextBlock Text="OpenAI Codex" FontSize="24" FontWeight="SemiBold"
                               Margin="0,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BoxBrush}"
                      BorderThickness="1.5" CornerRadius="12" Padding="24">
                <StackPanel>
                  <TextBlock Text="Created by" FontSize="13" HorizontalAlignment="Center"
                             Foreground="{DynamicResource SubBrush}"/>
                  <TextBlock Text="@rtxdevfn" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                             Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>

      <Border x:Name="SettingsView" Visibility="Collapsed" Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,10,8,8">
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="13" Background="#1B4B78" VerticalAlignment="Center">
                <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Settings}" Width="26" Height="26"
                         Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="VersionText" FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource SubBrush}"/>
              </StackPanel>
              <Button x:Name="SettingsDoneButton" Grid.Column="2" Content="Done" Width="100" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="APPEARANCE" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,24">
              <StackPanel>
                <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.SunMoon}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Theme" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Choose how Wintility looks. Follow Windows checks the Windows setting every 5 seconds." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource WinBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FollowSystemRadio" GroupName="AppTheme" Content="Follow Windows" Style="{StaticResource SegmentRadio}"/>
                        <RadioButton x:Name="LightRadio" GroupName="AppTheme" Content="Light" Style="{StaticResource SegmentRadio}"/>
                        <RadioButton x:Name="DarkRadio" GroupName="AppTheme" Content="Dark" Style="{StaticResource SegmentRadio}"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Image}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Background image" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Shows a soft color image behind the app." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="ShowBackgroundBox" Grid.Column="2" Style="{StaticResource MacSwitch}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Layers}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Glass effect" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Lets the window blur what is behind it." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                      <TextBlock x:Name="GlassNote" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="GlassBox" Grid.Column="2" Style="{StaticResource MacSwitch}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Padding="18,16" BorderThickness="0" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.WandSparkles}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Animations" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Fades and smooth switch movement. Follows the Windows animation setting." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="AnimationsBox" Grid.Column="2" Style="{StaticResource MacSwitch}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="SYSTEM" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,24">
              <StackPanel>
                <Border x:Name="ElevateCard" Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Shield}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Administrator access" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Some tweaks change settings for the whole PC and need administrator access. They stay hidden until you restart Wintility as administrator. A school or work PC may block this." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                      <TextBlock x:Name="ElevateNote" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Button x:Name="ElevateButton" Grid.Column="2" Content="Restart as administrator" Width="190" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Padding="18,16" BorderThickness="0" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Folder}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="File Explorer" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Taskbar, desktop and File Explorer tweaks refresh the desktop live. If one does not show up, restart File Explorer here. This closes open File Explorer windows and nothing else." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <Button x:Name="RestartExplorerButton" Grid.Column="2" Content="Restart File Explorer" Width="190" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="DATA" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,0,24">
              <StackPanel>
                <Border Padding="18,16" BorderThickness="0" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
                      <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Archive}" Width="20" Height="20"
                               Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="Backups" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Every change is backed up. Turning a switch off reverts it. Use this to restore a specific backup file." FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                    <Button x:Name="RestoreBackupButton" Grid.Column="2" Content="Restore a backup file..." Width="190" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border x:Name="LogView" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
      <Grid Margin="20,4,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,10,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="13" Background="#1B4B78" VerticalAlignment="Center">
            <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.FileText}" Width="26" Height="26"
                     Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Application Logs" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="LogLocationText" FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource SubBrush}"/>
          </StackPanel>
          <Button x:Name="RefreshLogButton" Grid.Column="2" Content="Refresh" Width="100" Style="{StaticResource ActionButton}"
                  Margin="0,0,8,0" VerticalAlignment="Center"/>
          <Button x:Name="LogDoneButton" Grid.Column="3" Content="Done" Width="100" Style="{StaticResource AccentButton}"
                  VerticalAlignment="Center"/>
        </Grid>
        <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontSize="12" Padding="14" Background="{DynamicResource CardBrush}"
                 Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource DividerBrush}"
                 BorderThickness="1"/>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed"/>
    </Grid>

    <Grid x:Name="StartupOverlay" Panel.ZIndex="100" Background="{DynamicResource WinBrush}" Opacity="0">
      <Image x:Name="SplashBackground" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <TransformGroup>
            <RotateTransform/>
            <TranslateTransform/>
          </TransformGroup>
        </Image.RenderTransform>
      </Image>
      <Border Background="{DynamicResource WinBrush}" Opacity="0.68" IsHitTestVisible="False"/>
      <Border x:Name="SplashProgressPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="560" Padding="34" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="18">
        <StackPanel>
          <TextBlock Text="Wintility" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="SplashVersion" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,28"
                     Foreground="{DynamicResource SubBrush}"/>
          <ProgressBar x:Name="SplashBar" Minimum="0" Maximum="100" Value="0" Height="6"
                       Foreground="#34C759" Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
          <TextBlock x:Name="SplashStatus" Text="Starting..." FontSize="12" HorizontalAlignment="Center"
                     Margin="0,12,0,0" Foreground="{DynamicResource SubBrush}"/>
        </StackPanel>
      </Border>
      <Border x:Name="SplashLaunchPanel" Visibility="Collapsed" VerticalAlignment="Center"
              HorizontalAlignment="Center" Width="440" Padding="38" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="18">
        <StackPanel>
          <TextBlock Text="Ready when you are" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="Your settings are loaded." FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,20"
                     Foreground="{DynamicResource SubBrush}"/>
          <Button x:Name="LaunchButton" Content="Launch" Width="150" Height="40" IsDefault="True"
                  HorizontalAlignment="Center" Style="{StaticResource StartupLaunchButton}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
