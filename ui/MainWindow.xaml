                    </StackPanel>
                    <Button x:Name="RestorePowerButton" Grid.Column="2" Content="Restore my original plan" Width="210" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            </StackPanel>
          </ScrollViewer>
