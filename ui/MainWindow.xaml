                  <StackPanel>
                    <TextBlock Text="Network adapter" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SubBrush}"/>
                    <ComboBox x:Name="DnsAdapterCombo" MinHeight="36" ItemTemplate="{StaticResource NetworkAdapterComboTemplate}" Style="{StaticResource DnsComboBox}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DNS provider" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SubBrush}"/>
                    <ComboBox x:Name="DnsProviderCombo" MinHeight="36" SelectedIndex="0" Style="{StaticResource DnsComboBox}">
                      <ComboBoxItem Content="Automatic (DHCP)" Tag="Automatic"/>
                      <ComboBoxItem Content="Cloudflare" Tag="Cloudflare"/>
                      <ComboBoxItem Content="Google" Tag="Google"/>
                      <ComboBoxItem Content="Quad9" Tag="Quad9"/>
                      <ComboBoxItem Content="AdGuard DNS" Tag="AdGuard"/>
                      <ComboBoxItem Content="Custom..." Tag="Custom"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="DnsDohCheckBox" Content="Use DNS over HTTPS when supported" IsEnabled="False" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="DnsAdminNote" Text="Changing DNS requires administrator access. Use Settings → Restart as administrator." FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SubBrush}"/>
                <TextBlock x:Name="DnsStatusText" Text="Select an adapter and resolver." FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SubBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
