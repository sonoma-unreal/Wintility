              </StackPanel>

            </Grid>
            <TextBlock Text="STARTUP, MEMORY &amp; SSD" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,24">
              <StackPanel>
                <Border Padding="18,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1B4B78" VerticalAlignment="Top">
