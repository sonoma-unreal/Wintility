        <TabItem Header="Internet" Tag="{DynamicResource Icon.Globe}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,8,16">
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="13" Background="#1B4B78" VerticalAlignment="Center">
                <Control Style="{StaticResource LucideIcon}" Tag="{DynamicResource Icon.Globe}" Width="26" Height="26" Foreground="#BFE4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Internet" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Tune Windows networking, DNS providers, and Microsoft Edge settings." FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource SubBrush}"/>
              </StackPanel>

            </Grid>
            <TextBlock Text="DNS &amp; NETWORK" FontSize="11.5" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource SubBrush}"/>
