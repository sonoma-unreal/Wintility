<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wintility" Width="1320" Height="720"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Window.Resources>
    <Style x:Key="SplashLaunchButton" TargetType="Button">
      <Setter Property="Background" Value="#1B4B78"/>
      <Setter Property="Foreground" Value="#EAF6FF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
              <Border.Effect>
                <DropShadowEffect x:Name="ButtonGlow" Color="#62B8FF" BlurRadius="0"
                                  ShadowDepth="0" Opacity="0"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ButtonGlow" Storyboard.TargetProperty="BlurRadius"
                                       To="22" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="ButtonGlow" Storyboard.TargetProperty="Opacity"
                                       To="0.9" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ButtonGlow" Storyboard.TargetProperty="BlurRadius"
                                       To="0" Duration="0:0:0.16"/>
                      <DoubleAnimation Storyboard.TargetName="ButtonGlow" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14"
          Background="{DynamicResource WinBrush}" ClipToBounds="True">
    <Grid x:Name="SplashSurface" Opacity="0">
      <Image x:Name="SplashBackground" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <TransformGroup>
            <RotateTransform x:Name="SplashBackgroundRotation"/>
            <TranslateTransform x:Name="SplashBackgroundDrift"/>
          </TransformGroup>
        </Image.RenderTransform>
      </Image>
      <Border Background="{DynamicResource WinBrush}" Opacity="0.68" IsHitTestVisible="False"/>
      <Border x:Name="SplashProgressPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
              Width="560" Padding="34" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="18">
        <StackPanel>
          <TextBlock Text="Wintility" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="SplashVersion" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,28"
                     Foreground="{DynamicResource SubBrush}"/>
          <ProgressBar x:Name="SplashBar" Minimum="0" Maximum="100" Value="0" Height="6"
                       Foreground="#34C759" Background="{DynamicResource DividerBrush}" BorderThickness="0"/>
          <TextBlock x:Name="SplashStatus" Text="Starting..." FontSize="12" HorizontalAlignment="Center"
                     Margin="0,12,0,0" Foreground="{DynamicResource SubBrush}"/>
        </StackPanel>
      </Border>
      <Border x:Name="SplashLaunchPanel" Visibility="Collapsed" VerticalAlignment="Center"
              HorizontalAlignment="Center" Width="440" Padding="38" Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="18">
        <StackPanel>
          <TextBlock Text="Ready when you are" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="Your settings are loaded." FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,20"
                     Foreground="{DynamicResource SubBrush}"/>
          <Button x:Name="LaunchButton" Content="Launch" Width="150" Height="40" IsDefault="True"
                  HorizontalAlignment="Center" Style="{StaticResource SplashLaunchButton}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
