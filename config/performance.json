    {
      "id": "EnableHardwareGpuScheduling",
      "name": "Hardware-accelerated GPU scheduling",
      "description": "Lets the GPU driver handle more of its own scheduling. Needs a supported driver and a restart. The benefit varies a lot by game.",
      "tab": "Performance",
      "category": "Gaming",
      "icon": "Cpu",
      "risk": "Medium",
