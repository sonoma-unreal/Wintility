{
  "schemaVersion": 1,
  "settings": [
    {
      "id": "DisableInkingPersonalization",
      "name": "Stop inking and typing personalization",
      "description": "Stops Windows from collecting what you type and write to personalize suggestions, and stops harvesting your contacts for it.",
      "tab": "Privacy",
      "category": "Typing",
      "risk": "Low",
      "action": "registry",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresLogoff": false,
      "reversible": true,
      "enabledByDefault": false,
      "registry": [
        {
          "path": "HKCU:\\Software\\Microsoft\\InputPersonalization",
          "name": "RestrictImplicitInkCollection",
          "type": "DWord",
          "appliedValue": 1,
          "defaultValue": 0
        },
        {
          "path": "HKCU:\\Software\\Microsoft\\InputPersonalization",
          "name": "RestrictImplicitTextCollection",
          "type": "DWord",
          "appliedValue": 1,
          "defaultValue": 0
        },
        {
          "path": "HKCU:\\Software\\Microsoft\\InputPersonalization\\TrainedDataStore",
          "name": "HarvestContacts",
          "type": "DWord",
          "appliedValue": 0,
          "defaultValue": 1
        },
        {
          "path": "HKCU:\\Software\\Microsoft\\Personalization\\Settings",
          "name": "AcceptedPrivacyPolicy",
          "type": "DWord",
          "appliedValue": 0,
          "defaultValue": 1
        }
      ]
    },
    {
      "id": "DisableTypingInsights",
      "name": "Turn off typing insights",
