    {
      "id": "DisableAdvertisingId",
      "name": "Turn off the advertising ID",
      "description": "Stops apps from using the advertising ID to personalize ads. This does not turn off Windows telemetry.",
      "tab": "Ads",
      "category": "Ads",
      "icon": "MegaphoneOff",
      "risk": "Low",
      "action": "registry",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresLogoff": false,
      "reversible": true,
      "enabledByDefault": false,
      "registry": [
        {
          "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
          "name": "Enabled",
          "type": "DWord",
          "appliedValue": 0,
          "defaultValue": 1
        }
      ]
    },
