{
  "schemaVersion": 1,
  "settings": [
    {
      "id": "EdgeNoBackgroundActivity",
      "name": "Edge: stop startup boost and background running",
      "description": "Stops Edge from preloading at sign-in and from running in the background after you close it. Edge will say it is managed by your organization. Restart Edge, then check edge://policy.",
      "tab": "Internet",
      "category": "Edge (current user)",
      "icon": "Globe",
      "risk": "Medium",
      "action": "registry",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresLogoff": false,
      "reversible": true,
      "enabledByDefault": false,
      "registry": [
        {
          "path": "HKCU:\\Software\\Policies\\Microsoft\\Edge",
          "name": "StartupBoostEnabled",
          "type": "DWord",
          "appliedValue": 0,
          "removeOnRevert": true
        },
        {
          "path": "HKCU:\\Software\\Policies\\Microsoft\\Edge",
          "name": "BackgroundModeEnabled",
          "type": "DWord",
          "appliedValue": 0,
          "removeOnRevert": true
        }
      ]
    },
